# Copied here for reference only: ./start-wolfchatter writes a real .env for you.
# Nothing in this file is secret, and .env itself is git-ignored.

PORT=3000
# Every origin the socket may be upgraded from. A handshake carrying no Origin at all is
# refused, so opening the dev server from a phone by its address on your network needs that
# address here too, next to the tile URL further down.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Leave DATABASE_URL unset to use the embedded database in apps/server/data/pg.
# With Docker, the wizard generates a password and writes both of these:
# DATABASE_URL=postgres://wolfchatter:change-me@localhost:5432/wolfchatter
# POSTGRES_PASSWORD=change-me

# Map tiles. Unset, the app draws the watercolour style through Stadia, which needs no key
# on localhost but answers 401 to any other host — so opening the dev server from a phone
# by its address on your network needs these two instead. The attribution is HTML and is
# single-quoted, because its own attributes use double quotes.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
