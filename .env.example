# Copied here for reference only: ./start-wolfchatter writes a real .env for you.
# Nothing in this file is secret, and .env itself is git-ignored.

PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Leave DATABASE_URL unset to use the embedded database in ./data/pg.
# With Docker, the wizard generates a password and writes both of these:
# DATABASE_URL=postgres://wolfchatter:change-me@localhost:5432/wolfchatter
# POSTGRES_PASSWORD=change-me
