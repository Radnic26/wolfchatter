# Copied here for reference only: ./start-wolfchatter writes a real .env for you.
# Nothing in this file is secret, and .env itself is git-ignored.

PORT=3000
# Every origin the socket may be upgraded from, and every origin allowed to write. A
# handshake carrying no Origin at all is refused. The wizard adds this machine's addresses
# on the network here, so the app can be opened on a phone on the same Wi-Fi; the server
# also allows its own, which covers `npm run dev` after the network changes.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.20:3000,http://192.168.1.20:5173

# A first run opens on a map with a few sample rooms and messages on it, which is what the
# wizard writes here. The server seeds only a database with no rooms in it, so this line
# does nothing from the second boot on, and deleting it stops a fresh database being seeded.
SEED_SAMPLE_DATA=true

# Set this only where a proxy in front of this process terminates TLS, and set it to the
# header that proxy appends the caller's address to. It is what the per-IP write limit
# counts, so with no proxy to overwrite it a caller would simply name itself; unset, the
# limit counts the socket peer, which is the right answer for the dev server and Docker.
# TRUSTED_CLIENT_HEADER=X-Forwarded-For

# Leave DATABASE_URL unset to use the embedded database in apps/server/data/pg.
# With Docker, the wizard generates a password and writes both of these:
# DATABASE_URL=postgres://wolfchatter:change-me@localhost:5432/wolfchatter
# POSTGRES_PASSWORD=change-me
