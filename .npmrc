# engine-strict is deliberately not set. `jsdom` declares LTS-only engines
# (^22.22.2 || ^24.15.0 || >=26.0.0), so on an odd Node line — 25, say — strict mode turns
# that declaration into a fatal EBADENGINE and `npm install` exits 1, which takes the whole
# first run with it. The declaration is conservative rather than real: the full suite passes
# on 25.9.0. The Node floor that matters is enforced by start-wolfchatter, before npm runs.
save-exact=true
