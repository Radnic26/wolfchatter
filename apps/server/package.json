{
  "name": "@wolfchatter/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono HTTP API and WebSocket hub over PostgreSQL",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=.env apps/server/src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@wolfchatter/shared": "*",
    "hono": "4.13.5",
    "pg": "8.23.0",
    "ws": "8.21.3",
    "zod": "4.5.4"
  }
}
